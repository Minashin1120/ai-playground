def get_files_lib():
    files = []; seen = set()
    msgs = Message.query.join(Thread).filter(Thread.user_id == current_user.id, Message.image_url != None).order_by(Message.timestamp.desc()).all()
    for m in msgs:
        if m.image_url:
            try: l = json.loads(m.image_url)
            except: l = [m.image_url]
            for p in l:
                if not p or p in seen: continue
                sec, sta = os.path.join(app.config['UPLOAD_FOLDER_SECURE'], p), os.path.join(app.config['UPLOAD_FOLDER_STATIC'], p)
                fp, url = (sec, url_for('secure_uploads', filename=p)) if os.path.exists(sec) else ((sta, url_for('static', filename='uploads/'+p)) if os.path.exists(sta) else (None, None))
                if fp: seen.add(p); files.append({'filename': os.path.basename(p), 'filepath': p, 'url': url, 'type': 'image' if 'png' in p or 'jpg' in p or 'webp' in p else 'file'})
    return jsonify(files)

