# 必須: `python -c 'import secrets; print(secrets.token_urlsafe(64))'` 等で生成
FLASK_SECRET_KEY=
DATABASE_URL=mysql+pymysql://ai_chat_user:change_me@localhost/ai_chat_db?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/10
TRUSTED_HOSTS=chat.example.com
# 初回登録前は空欄。登録後に同じユーザー名を設定して全サービスを再起動
PRIMARY_ADMIN_USERNAME=

# 通常運用では0。リリース固有の指示がある場合だけ、DBバックアップ後に1で単独起動
RUN_SCHEMA_MIGRATIONS=0
VERBOSE_DEBUG_LOGS=0
ENABLE_HTTP_GZIP=1

# サーバー側APIキー（任意）。ユーザーは画面から自分のキーを登録可能
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
XAI_API_HOST=api.x.ai

# Google OAuth（任意）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Minashin 中央アカウント連携（OAuth 2.0 + PKCE）（任意）
# 既定は本番の https://account.minashin1120.com のため、通常は設定不要。
# 開発用ステージング等で変える場合のみ指定する。
# MINASHIN_ACCOUNT_BASE_URL=https://account.minashin1120.com

# Gemini Vertex AI（任意。ADCを使う場合はサービス側の認証も設定）
GEMINI_BACKEND=gemini_api
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=global
GEMINI_VERTEX_SERVICE_ACCOUNT_JSON=

# Cloudflare Turnstile（任意）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# アップロードと保存容量
UPLOAD_MAX_MB=512
USER_STORAGE_LIMIT_MB=100
ATTACHMENT_MAX_FILES=30
ATTACHMENT_MAX_MB=20
ATTACHMENT_TOTAL_MAX_MB=60
UPLOAD_CONCURRENCY=3

# RQキュー。通常は既定値のままでよい
AI_CHAT_FAST_QUEUE=ai_chat_fast_queue
AI_CHAT_HEAVY_QUEUE=ai_chat_heavy_queue
# インスタンス別に上書きする例:
# RQ_QUEUES_INSTANCE_1=ai_chat_fast_queue,ai_chat_heavy_queue,ai_chat_queue
# RQ_QUEUES_INSTANCE_3=ai_chat_heavy_queue,ai_chat_fast_queue,ai_chat_queue

# 開発サーバー（本番のsystemd/Gunicornでは未使用）
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=0

# 通信タイムアウト／コネクションプール（通常は変更不要）
AI_CHAT_HTTP2=1
AI_CHAT_HTTP_MAX_CONNECTIONS=100
AI_CHAT_HTTP_MAX_KEEPALIVE=20
AI_CHAT_HTTP_KEEPALIVE_EXPIRY=30
OPENAI_CONNECT_TIMEOUT_SECONDS=5
OPENAI_READ_TIMEOUT_SECONDS=120
OPENAI_WRITE_TIMEOUT_SECONDS=30
OPENAI_POOL_TIMEOUT_SECONDS=5
OPENAI_MAX_RETRIES=1
OPENAI_IMAGE_TIMEOUT_SECONDS=120
OPENAI_IMAGE_MAX_RETRIES=1
OPENAI_IMAGE_DEFAULT_SIZE=1024x1024
OPENAI_IMAGE_DEFAULT_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_OUTPUT_COMPRESSION=85
OPENAI_FILE_CACHE_TTL_HOURS=24
OPENAI_FILE_UPLOAD_RETRIES=2
GEMINI_TIMEOUT_MS=120000
GEMINI_AGENTIC_TIMEOUT_MS=600000
GEMINI_FILE_UPLOAD_RETRIES=2
XAI_TIMEOUT_SECONDS=120

# メモリ／履歴上限（0は該当キャッシュまたは上限を無効化）
MAX_CONTEXT_MESSAGES=0
MAX_CONTEXT_TOKENS=0
DECRYPT_TEXT_CACHE_MAX=4096
MEDIA_BYTES_CACHE_MAX_MB=128
MEDIA_BYTES_CACHE_ITEM_MAX_MB=12
HISTORY_IMAGE_MAX_ITEMS=0
HISTORY_IMAGE_MAX_MB=0
LOW_LATENCY_IMAGE_MAX_ITEMS=4
LOW_LATENCY_IMAGE_MAX_MB=12
GEMINI_INLINE_IMAGE_MAX_MB=12
THUMBNAIL_CACHE_MAX_MB=48
THUMBNAIL_CACHE_ITEM_MAX_MB=2
THUMBNAIL_SIZE=320
THUMBNAIL_QUALITY=78

# Cloudflareキャッシュ削除スクリプト用（アプリ本体では未使用）
# 最小権限のAPIトークンを使用すること
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_API_KEY=
# CF_API_EMAIL=
# CF_PURGE_HOSTS=chat.example.com
