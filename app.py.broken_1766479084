@app.route('/chat_stream', methods=['POST'])
@login_required
def chat_stream():
    try:
        import uuid
        data = request.json
        job_id = str(uuid.uuid4())
        print(f"DEBUG: Request thread {data.get('thread_id')}", flush=True)
        sys_p = decrypt_val(current_user.system_prompt) if current_user.use_e2ee else current_user.system_prompt
        options = {'enable_thinking': data.get('enable_thinking'), 'thinking_level': data.get('thinking_level', 'high'), 'system_prompt': sys_p}
        api_keys = {'openai': get_key_for_user(current_user, 'OPENAI_API_KEY'), 'gemini': get_key_for_user(current_user, 'GEMINI_API_KEY'), 'xai': get_key_for_user(current_user, 'XAI_API_KEY')}
        user_msg = data.get('message')
        db.session.add(Message(thread_id=data.get('thread_id'), role='user', content=encrypt_val(user_msg) if current_user.use_e2ee else user_msg))
        db.session.commit()
        task_queue.enqueue(background_chat_task, job_id, data.get('thread_id'), data.get('model'), user_msg, data.get('image_urls', []), options, api_keys, current_user.id, {'use_e2ee': current_user.use_e2ee, 'use_secure_files': current_user.use_secure_files})

        def generate():
            pubsub = redis_conn.pubsub()
            pubsub.subscribe(f"ai_chat:channel:{job_id}")
            st = time.time()
            try:
                for m in pubsub.listen():
                    if time.time() - st > 600: yield json.dumps({"type": "error", "data": "Timeout"}) + "\n"; break
                    if m['type'] == 'message':
                        payload = m['data'].decode('utf-8')
                        yield payload + "\n"
                        if '"type": "done"' in payload or '"type": "error"' in payload: break
            finally: pubsub.close()
        return Response(stream_with_context(generate()), mimetype='application/json')
    except Exception as e:
        app.logger.error(traceback.format_exc()); return jsonify({'error': str(e)}), 500

def background_chat_task(job_id, thread_id, model_key, message_text, img_list, options, api_keys, user_id, security_prefs):
    with app.app_context():
        channel = f"ai_chat:channel:{job_id}"
        r = redis.from_url(REDIS_URL)
        def pub(t, d): r.publish(channel, json.dumps({"type": t, "data": d}))
        try:
            print(f"DEBUG: Worker start Job {job_id}", flush=True)
            bd = app.config['UPLOAD_FOLDER_SECURE'] if security_prefs.get('use_secure_files') else app.config['UPLOAD_FOLDER_STATIC']
            req_key = api_keys.get('gemini') if 'gemini' in model_key else (api_keys.get('xai') if 'grok' in model_key else api_keys.get('openai'))
            if not req_key: pub("error", "Key missing"); return
            
            full_res, thought = "", ""
            if 'gemini' in model_key:
                client = genai.Client(api_key=req_key, http_options={'api_version': 'v1alpha'})
                real_m = "gemini-3-flash-preview" if "3-flash" in model_key else ("gemini-3-pro-preview" if "3.0" in model_key else model_key)
                cfg = types.GenerateContentConfig(temperature=0.7)
                if options.get('enable_thinking'): cfg.thinking_config = types.ThinkingConfig(include_thoughts=True, thinking_level=options.get('thinking_level', 'high'))
                if options.get('system_prompt'): cfg.system_instruction = options.get('system_prompt')
                
                contents = []
                # History
                msgs = Message.query.filter_by(thread_id=thread_id).order_by(Message.timestamp).all()
                for m in msgs[:-1]:
                    contents.append(types.Content(role='model' if m.role == 'assistant' else 'user', parts=[types.Part(text=decrypt_val(m.content))]))
                
                parts = [types.Part(text=message_text)]
                for fn in img_list:
                    p = os.path.join(bd, fn)
                    if os.path.exists(p):
                        with open(p, 'rb') as f: parts.append(types.Part.from_bytes(data=f.read(), mime_type='image/webp'))
                contents.append(types.Content(role='user', parts=parts))
                
                for chunk in client.models.generate_content_stream(model=real_m, contents=contents, config=cfg):
                    if chunk.candidates:
                        for p in chunk.candidates[0].content.parts:
                            if hasattr(p, 'thought') and p.thought: thought += p.thought; pub("thought", p.thought)
                            if p.text: full_res += p.text; pub("content", p.text)
            else:
                client = OpenAI(api_key=req_key, base_url="https://api.x.ai/v1" if 'grok' in model_key else None)
                msgs = []
                if options.get('system_prompt'): msgs.append({"role": "system", "content": options.get('system_prompt')})
                all_m = Message.query.filter_by(thread_id=thread_id).order_by(Message.timestamp).all()
                for m in all_m[:-1]: msgs.append({"role": m.role, "content": decrypt_val(m.content)})
                msgs.append({"role": "user", "content": message_text})
                
                for chunk in client.chat.completions.create(model=model_key, messages=msgs, stream=True):
                    delta = chunk.choices[0].delta
                    if hasattr(delta, 'reasoning_content') and delta.reasoning_content:
                        thought += delta.reasoning_content; pub("thought", delta.reasoning_content)
                    if delta.content:
                        full_res += delta.content; pub("content", delta.content)

            final_c = encrypt_val(full_res) if security_prefs.get('use_e2ee') else full_res
            final_t = encrypt_val(json.dumps({'text': thought})) if security_prefs.get('use_e2ee') and thought else (json.dumps({'text': thought}) if thought else None)
            
            db.session.add(Message(thread_id=thread_id, role='assistant', content=final_c, model=model_key, thought_data=final_t))
            db.session.commit(); pub("done", "OK")
            print(f"DEBUG: Worker success Job {job_id}", flush=True)
        except Exception as e:
            print(f"DEBUG: Worker Error: {str(e)}", flush=True)
            pub("error", str(e))

