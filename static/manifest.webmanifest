{
  "name": "AI Chat Playground",
  "short_name": "AI Chat",
  "description": "AI models を切り替えて使えるプライベートなチャットプレイグラウンド。",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0f1720",
  "theme_color": "#0f1720",
  "orientation": "portrait-primary",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/static/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "チャットを開く",
      "short_name": "Chat",
      "description": "AI チャット画面を開きます。",
      "url": "/"
    }
  ]
}
