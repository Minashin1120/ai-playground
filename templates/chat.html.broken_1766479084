<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AI Playground (V3.5.2)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked@4.3.0/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #111827; color: #f3f4f6; }
        .prose { font-size: 0.95rem; line-height: 1.7; color: #e5e7eb; max-width: none; }
        .prose pre { background: #0f1117 !important; padding: 0 !important; }
        .prose code { font-family: monospace; background: transparent !important; }
        .thought-container { margin-bottom: 1rem; border-radius: 0.375rem; overflow: hidden; border: 1px solid #4b5563; }
        .thought-header { background: #374151; padding: 0.5rem; font-size: 0.75rem; color: #9ca3af; cursor: pointer; }
        .thought-content { background: #1f2937; padding: 0.75rem; font-size: 0.85rem; color: #d8b4fe; white-space: pre-wrap; font-family: monospace; }
        .thought-content.collapsed { display: none; }
        #debug-console { position: fixed; bottom: 0; right: 0; width: 100%; md:width: 600px; height: 300px; background: rgba(0,0,0,0.9); z-index: 9999; border-top: 1px solid #444; display: none; flex-direction: column; }
    </style>
</head>
<body class="h-[100dvh] flex overflow-hidden text-sm md:text-base">
    <div id="sidebar" class="w-64 bg-gray-800 border-r border-gray-700 flex flex-col shrink-0">
        <div class="p-3 border-b border-gray-700 flex justify-between items-center">
            <h2 class="font-bold text-gray-200">AI Chat</h2>
            <div class="flex gap-1">
                {% if admin_user %}<button onclick="toggleDebug()" class="text-gray-400 hover:text-yellow-400 p-1.5"><i class="fas fa-wrench text-xs"></i></button>{% endif %}
                <a href="https://github.com/Minashin1120/ai-playground" target="_blank" class="text-gray-400 hover:text-white p-1.5"><i class="fab fa-github text-xs"></i></a>
                <button id="settings-btn" class="text-gray-400 hover:text-green-400 p-1.5"><i class="fas fa-cog text-xs"></i></button>
                <button id="new-chat-btn" class="p-1.5 bg-blue-600 rounded text-white"><i class="fas fa-plus text-xs"></i></button>
            </div>
        </div>
        <div id="thread-list" class="flex-1 overflow-y-auto p-2 space-y-1"></div>
        <div class="p-3 border-t border-gray-700 text-center text-xs text-gray-500">v3.5.2 STABLE</div>
    </div>

    <div class="flex-1 flex flex-col min-w-0">
        <div id="chat-container" class="flex-1 overflow-y-auto p-4 space-y-6"></div>
        <div class="p-3 bg-gray-800 border-t border-gray-700">
            <div class="max-w-3xl mx-auto flex gap-2">
                <select id="model-select" class="bg-gray-700 text-white rounded px-2 py-1 text-xs outline-none">
                    <optgroup label="Gemini">
                        <option value="gemini-3-flash-preview">Gemini 3 Flash</option>
                        <option value="gemini-3-pro-preview">Gemini 3 Pro</option>
                    </optgroup>
                    <optgroup label="xAI">
                        <option value="grok-4-fast-reasoning">Grok 4 Fast (Reasoning)</option>
                    </optgroup>
                    <optgroup label="OpenAI">
                        <option value="gpt-4o">GPT-4o</option>
                    </optgroup>
                </select>
                <textarea id="prompt-input" class="flex-1 bg-gray-700 rounded p-2 text-white outline-none resize-none" rows="1" placeholder="Ctrl+Enter..."></textarea>
                <button id="send-btn" class="bg-blue-600 p-2 rounded text-white"><i class="fas fa-paper-plane"></i></button>
            </div>
            <div class="flex gap-2 justify-center mt-2">
                <label class="text-xs text-gray-400"><input type="checkbox" id="enable-thinking" checked> Thinking</label>
                <div id="thinking-level-container" class="flex items-center gap-1">
                    <span class="text-[10px] text-gray-500">Level:</span>
                    <select id="thinking-level" class="bg-gray-700 text-white text-[10px] rounded"><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option><option value="minimal">Minimal</option></select>
                </div>
            </div>
        </div>
    </div>

    <div id="debug-console" class="p-2 font-mono text-[10px]">
        <div class="flex justify-between border-b border-gray-700 mb-1 pb-1">
            <span class="text-green-500">LIVE LOGS</span>
            <button onclick="toggleDebug()" class="text-red-500">✕</button>
        </div>
        <div id="debug-content" class="flex-1 overflow-y-auto space-y-0.5 text-gray-400"></div>
    </div>

    <script>
        const get = id => document.getElementById(id);
        let currentThreadId = null;
        let debugEventSource = null;

        {% if admin_user %}
        window.addEventListener('DOMContentLoaded', () => { startDebugStream(); });
        {% endif %}

        function startDebugStream() {
            if (debugEventSource) return;
            debugEventSource = new EventSource('/api/debug/logs');
            debugEventSource.onmessage = e => {
                const div = document.createElement('div');
                div.textContent = e.data;
                if (e.data.includes('[WORKER]')) div.className = 'text-green-400';
                if (e.data.includes('DEBUG:')) div.className = 'text-yellow-400';
                get('debug-content').appendChild(div);
                get('debug-content').scrollTop = get('debug-content').scrollHeight;
            };
        }

        function toggleDebug() {
            const c = get('debug-console');
            c.style.display = (c.style.display === 'flex') ? 'none' : 'flex';
        }

        function toggleThinking(header) {
            header.nextElementSibling.classList.toggle('collapsed');
        }

        get('send-btn').onclick = async () => {
            const msg = get('prompt-input').value;
            if(!msg) return;
            if(!currentThreadId) { 
                const res = await fetch('/api/threads', {method:'POST'});
                const d = await res.json(); currentThreadId = d.id;
            }
            renderMsg('user', msg);
            get('prompt-input').value = '';
            
            const res = await fetch('/chat_stream', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    thread_id: currentThreadId,
                    message: msg,
                    model: get('model-select').value,
                    enable_thinking: get('enable-thinking').checked,
                    thinking_level: get('thinking-level').value
                })
            });
            const reader = res.body.getReader();
            const decoder = new TextDecoder();
            let aiMsgId = 'ai-' + Date.now();
            let aiText = "";
            renderMsg('assistant', "...", aiMsgId);
            
            let thoughtAcc = "";
            let thoughtDiv = null;

            while(true) {
                const {done, value} = await reader.read();
                if(done) break;
                const lines = decoder.decode(value).split('\n');
                for(let line of lines) {
                    if(!line) continue;
                    try {
                        const json = JSON.parse(line);
                        const contentDiv = document.getElementById(aiMsgId).querySelector('.prose');
                        
                        if(json.type === 'thought') {
                            if(!thoughtDiv) {
                                thoughtDiv = document.createElement('div');
                                thoughtDiv.className = 'thought-container';
                                thoughtDiv.innerHTML = '<div class="thought-header" onclick="toggleThinking(this)">Thinking Process</div><div class="thought-content"></div>';
                                document.getElementById(aiMsgId).insertBefore(thoughtDiv, contentDiv);
                            }
                            thoughtAcc += json.data;
                            thoughtDiv.querySelector('.thought-content').innerText = thoughtAcc;
                        } else if(json.type === 'content') {
                            aiText += json.data;
                            contentDiv.innerHTML = marked.parse(aiText);
                            contentDiv.querySelectorAll('pre code').forEach((block) => { hljs.highlightElement(block); });
                        }
                    } catch(e){}
                }
                get('chat-container').scrollTop = get('chat-container').scrollHeight;
            }
        };

        function renderMsg(role, text, id) {
            const div = document.createElement('div');
            div.className = `flex ${role==='user'?'justify-end':'justify-start'} mb-4`;
            div.innerHTML = `<div id="${id||''}" class="p-3 rounded-lg ${role==='user'?'bg-blue-600':'bg-gray-700'} max-w-[90%]"><div class="prose prose-invert text-sm">${text}</div></div>`;
            get('chat-container').appendChild(div);
            get('chat-container').scrollTop = get('chat-container').scrollHeight;
        }

        get('prompt-input').onkeydown = e => { if((e.ctrlKey||e.metaKey)&&e.key==='Enter') get('send-btn').click(); };
        
        // Initial load
        fetch('/api/threads').then(r=>r.json()).then(d=>{
            d.forEach(t=>{
                const div=document.createElement('div');
                div.className='p-2 hover:bg-gray-700 cursor-pointer text-gray-400 text-xs truncate';
                div.innerText=t.title;
                get('thread-list').appendChild(div);
            });
        });
    </script>
</body>
</html>
