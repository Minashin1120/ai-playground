[Unit]
# Template RQ worker. メモリ負荷対策で @1 / @2 の2インスタンスのみ有効にする
# （デプロイ手順は deploy/systemd/README.md を参照。ホスト RAM が小さいため
#   3・4番を起動するとスワップでリクエストが10秒以上ストールする）。
Description=AI Chat Playground RQ worker %i
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ai-playground
Group=ai-playground
WorkingDirectory=/opt/ai-playground
EnvironmentFile=/opt/ai-playground/.env
Environment="PATH=/opt/ai-playground/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="WORKER_INSTANCE=%i"
ExecStart=/opt/ai-playground/venv/bin/python worker.py
Restart=always
RestartSec=5
TimeoutStopSec=660
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-chat-worker-%i

[Install]
WantedBy=multi-user.target
